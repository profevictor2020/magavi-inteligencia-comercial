# Django: use a newly generated, private value outside source control.
DJANGO_SECRET_KEY=change-me-in-your-environment
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173

# PostgreSQL only. Render injects its internal connection URL in production.
DATABASE_URL=postgresql://magavi:change-me@localhost:5432/magavi

# Security defaults to true in production and false in development.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Gunicorn
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
